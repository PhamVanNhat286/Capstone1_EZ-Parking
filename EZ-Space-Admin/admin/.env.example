# Đặt Admin cùng cấp với backend/ để tự đọc backend/.env.
# Nếu Admin ở ngoài thư mục Capstone1_EZ-Parking, sao chép file này thành .env.local.
# Không commit .env.local lên Git, không chia sẻ mật khẩu.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=ez_space
DB_USER=postgres
DB_PASSWORD=YOUR_POSTGRES_PASSWORD
ADMIN_PORT=8000
